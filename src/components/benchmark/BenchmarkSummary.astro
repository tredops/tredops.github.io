---
// Resumen del benchmark: tabla final por agente + tarjetas de contexto.
// Se calcula en build a partir del mismo fichero exportado de TredOps.
import { DEFAULT_EDITION, loadScene } from "./scene";
import { money, capitalPercent, initialsOf } from "./format";

interface Props {
	edition?: string;
	lang?: "es" | "en";
}

const { edition = DEFAULT_EDITION, lang = "en" } = Astro.props;

const t = {
	es: {
		bestAgent: "Mejor agente", span: "Pérdida / ganancia", points: "ptos",
		closedTrades: "Operaciones cerradas", initialCapital: "Capital inicial",
		every: (v: string) => `Cada ${v}`, samples: "muestras", agents: "agentes",
		agent: "Agente", model: "Modelo", finalEquity: "Equity final",
		maxMin: "Máx / mín", closed: "Cerradas", open: "Abiertas",
		barsLabel: "Equity final por agente", locale: "es-ES",
	},
	en: {
		bestAgent: "Best agent", span: "Loss / gain", points: "pts",
		closedTrades: "Closed trades", initialCapital: "Initial capital",
		every: (v: string) => `Every ${v}`, samples: "samples", agents: "agents",
		agent: "Agent", model: "Model", finalEquity: "Final equity",
		maxMin: "Max / min", closed: "Closed", open: "Open",
		barsLabel: "Final equity per agent", locale: "en-US",
	},
}[lang];
const scene = loadScene(edition);
const { portfolios, frames, range } = scene;
const last = frames[frames.length - 1];
const byId = new Map(portfolios.map((p) => [p.portfolioId, p]));

const finalRows = [...last.rows].sort((a, b) => a.rank - b.rank);
const agentStats = finalRows.map((r) => {
	const series = frames.map((f) => f.rows.find((x) => x.portfolioId === r.portfolioId)).filter(Boolean);
	const best = series.reduce((m, x) => (x.equity > m.equity ? x : m), series[0]);
	const worst = series.reduce((m, x) => (x.equity < m.equity ? x : m), series[0]);
	const entry = byId.get(r.portfolioId);
	return {
		portfolioId: r.portfolioId,
		rank: r.rank,
		label: entry?.label || r.label,
		subtitle: entry?.subtitle ?? entry?.model ?? null,
		model: entry?.model || null,
		avatarUrl: entry?.avatarUrl || null,
		color: entry?.color || "#6b7280",
		equity: r.equity,
		profitPct: r.profitPct,
		profitPctFromStart: r.profitPctFromStart,
		liquidity: r.liquidity,
		invested: r.positions.reduce((s, p) => s + p.c, 0),
		wins: r.wins,
		losses: r.losses,
		openCount: r.openCount,
		closedCount: r.closedCount,
		maxEquity: best.equity,
		minEquity: worst.equity,
	};
});

const totalClosed = agentStats.reduce((s, a) => s + a.closedCount, 0);
const totalWins = agentStats.reduce((s, a) => s + a.wins, 0);
const totalLosses = agentStats.reduce((s, a) => s + a.losses, 0);
const best = agentStats[0];
const worst = agentStats[agentStats.length - 1];
const spanPct = best.profitPct - worst.profitPct;
const maxEquityOverall = Math.max(...frames.flatMap((f) => f.rows.map((r) => r.equity)));
const initial = frames[0].rows[0]?.equity ?? null;
const barPct = (v) => Math.max(2, (v / maxEquityOverall) * 100);
---

<div class="b-summary">
	<div class="b-sum-grid">
		<div class="b-sum-card"><span class="b-sum-k">{t.bestAgent}</span><span class="b-sum-v b-win">{best.label} · {capitalPercent(best.profitPct)}</span></div>
		<div class="b-sum-card"><span class="b-sum-k">{t.span}</span><span class="b-sum-v">{spanPct.toFixed(2)} {t.points}</span></div>
		<div class="b-sum-card"><span class="b-sum-k">{t.closedTrades}</span><span class="b-sum-v">{totalClosed} ({totalWins} W · {totalLosses} L)</span></div>
		<div class="b-sum-card"><span class="b-sum-k">{t.initialCapital}</span><span class="b-sum-v">{initial == null ? "—" : money(initial, 0)}</span></div>
	</div>

	<div class="b-sum-window">
		<span>{t.every(range.stepHours < 24 ? `${range.stepHours} h` : `${range.stepHours / 24} d`)} · {frames.length} {t.samples}</span>
		<span role="separator">·</span>
		<span>{new Date(range.from).toLocaleDateString(t.locale, { day: "numeric", month: "short" })} → {new Date(range.to).toLocaleDateString(t.locale, { day: "numeric", month: "short", year: "numeric" })}</span>
		<span role="separator">·</span>
		<span>{portfolios.length} {t.agents}</span>
	</div>

	<div class="b-sum-scroll">
	<table class="b-sum-table">
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">{t.agent}</th>
				<th scope="col">{t.model}</th>
				<th scope="col">{t.finalEquity}</th>
				<th scope="col">P&amp;L</th>
				<th scope="col">{t.maxMin}</th>
				<th scope="col">W / L</th>
				<th scope="col">{t.closed}</th>
				<th scope="col">{t.open}</th>
			</tr>
		</thead>
		<tbody>
			{agentStats.map((a) => (
				<tr>
					<td>{a.rank}</td>
					<td>
						<div class="b-sum-agent">
							<span class="b-sum-av" style={`background:${a.color};border-radius:50%`}>
								{a.avatarUrl ? <img src={a.avatarUrl} alt={a.label} loading="lazy" /> : <span>{initialsOf(a.label)}</span>}
							</span>
							<span class="b-sum-an">{a.label}</span>
						</div>
					</td>
					<td><code>{a.model || "—"}</code></td>
					<td class="b-num">{money(a.equity, 0)}</td>
					<td class={a.profitPct >= 0 ? "b-win" : "b-loss"}>{capitalPercent(a.profitPct)}</td>
					<td class="b-num b-sub">{money(a.maxEquity, 0)} / {money(a.minEquity, 0)}</td>
					<td class="b-num">{a.wins} / {a.losses}</td>
					<td class="b-num">{a.closedCount}</td>
					<td class="b-num">{a.openCount}</td>
				</tr>
			))}
		</tbody>
	</table>
	</div>

	<div class="b-sum-bars" aria-label={t.barsLabel}>
		{agentStats.map((a) => (
			<div class="b-sum-bar-row">
				<span class="b-sum-bar-name">{a.label}</span>
				<div class="b-sum-bar-track"><div class="b-sum-bar-fill" style={`width:${barPct(a.equity)}%;background:${a.color}`} title={`${a.label}: ${money(a.equity, 0)}`}></div></div>
				<span class="b-sum-bar-val">{money(a.equity, 0)}</span>
			</div>
		))}
	</div>
</div>

<style>
	.b-summary { margin: 1.25rem 0; display: grid; gap: 1rem; }
	.b-sum-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem; }
	.b-sum-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border-radius: 0.6rem;
		padding: 0.75rem 0.875rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
	}
	.b-sum-k { font-size: 0.75rem; color: var(--sl-color-gray-3); }
	.b-sum-v { font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
	.b-sum-window { display: flex; flex-wrap: wrap; gap: 0.375rem 0.5rem; font-size: 0.8rem; color: var(--sl-color-gray-3); }
	.b-sum-window [role="separator"] { color: var(--sl-color-gray-5); }
	.b-win { color: #059669; }
	.b-loss { color: #dc2626; }
	:root[data-theme='dark'] .b-win { color: #34d399; }
	:root[data-theme='dark'] .b-loss { color: #f87171; }
	.b-num { font-variant-numeric: tabular-nums; text-align: right; }
	.b-sub { font-size: 0.8rem; color: var(--sl-color-gray-3); }

	.b-sum-scroll { max-width: 100%; overflow-x: auto; }
	.b-sum-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
	.b-sum-table th {
		text-align: left;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
		padding: 0.5rem 0.625rem;
	}
	.b-sum-table td { padding: 0.5rem 0.625rem; border-top: 1px solid var(--sl-color-gray-5); vertical-align: middle; }
	.b-sum-table .b-num { text-align: right; }
	.b-sum-table code { font-size: 0.78rem; }
	.b-sum-agent { display: flex; align-items: center; gap: 0.5rem; }
	.b-sum-av {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
	}
	.b-sum-av img { width: 100%; height: 100%; object-fit: contain; }
	.b-sum-av span { font-size: 9px; font-weight: 600; color: #fff; }
	.b-sum-an { font-weight: 600; }

	.b-sum-bars { display: grid; gap: 0.375rem; }
	.b-sum-bar-row { display: grid; grid-template-columns: 9rem 1fr 5.5rem; align-items: center; gap: 0.625rem; font-size: 0.8rem; }
	.b-sum-bar-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.b-sum-bar-track {
		height: 0.9rem;
		border-radius: 0.375rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		overflow: hidden;
	}
	.b-sum-bar-fill { height: 100%; border-radius: 0.375rem; transition: width 0.6s ease; opacity: 0.9; }
	.b-sum-bar-val { text-align: right; font-variant-numeric: tabular-nums; }

	@media (max-width: 720px) {
		.b-sum-table { font-size: 0.8rem; }
		.b-sum-bar-row { grid-template-columns: 7rem 1fr 4.5rem; }
	}
</style>