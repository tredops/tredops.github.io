---
// Detalle por agente del Benchmark: pestañas con las posiciones abiertas
// (último frame) y cerradas (acumuladas de todos los frames, con motivo).
// Datos calculados en build a partir de src/data/benchmark-full.json.
import { DEFAULT_EDITION, loadScene } from "./scene";
import { money, capitalPercent, initialsOf, formatDay } from "./format";

interface Props {
	edition?: string;
	lang?: "es" | "en";
}

const { edition = DEFAULT_EDITION, lang = "en" } = Astro.props;
const scene = loadScene(edition);

const t = {
	es: {
		open: "Posiciones abiertas",
		closed: "Posiciones cerradas",
		noneOpen: "Sin posiciones abiertas al cierre.",
		noneClosed: "Sin operaciones cerradas.",
		asset: "Activo",
		side: "Lado",
		capital: "Capital",
		pnl: "P&L",
		pnlPct: "P&L %",
		price: "Precio",
		status: "Estado",
		reason: "Motivo",
		date: "Fecha",
		equity: "Equity final",
		invested: "Invertido",
		cash: "Liquidez",
		realized: "Realizado",
		unrealized: "No realizado",
		openChip: "Abiertas",
		closedChip: "Cerradas",
		winloss: "W / L",
		stale: "desfasada",
		long: "largo",
		short: "corto",
		tabLabel: "Agentes del benchmark",
	},
	en: {
		open: "Open positions",
		closed: "Closed positions",
		noneOpen: "No open positions at close.",
		noneClosed: "No closed trades.",
		asset: "Asset",
		side: "Side",
		capital: "Capital",
		pnl: "P&L",
		pnlPct: "P&L %",
		price: "Price",
		status: "Status",
		reason: "Reason",
		date: "Date",
		equity: "Final equity",
		invested: "Invested",
		cash: "Cash",
		realized: "Realized",
		unrealized: "Unrealized",
		openChip: "Open",
		closedChip: "Closed",
		winloss: "W / L",
		stale: "stale",
		long: "long",
		short: "short",
		tabLabel: "Benchmark agents",
	},
}[lang];

const REASONS: Record<string, { es: string; en: string }> = {
	takeProfit: { es: "Take profit", en: "Take profit" },
	stopLoss: { es: "Stop loss", en: "Stop loss" },
	expired: { es: "Expiración", en: "Expiry" },
	expiry: { es: "Expiración", en: "Expiry" },
	manual: { es: "Manual", en: "Manual" },
	reversed: { es: "Reversión", en: "Reversal" },
	signal: { es: "Señal", en: "Signal" },
};

const reasonOf = (r: string | null) => (r ? REASONS[r]?.[lang] ?? r : "—");

const lastFrame = scene.frames[scene.frames.length - 1];

const agents = scene.portfolios.map((p) => {
	const row = lastFrame.rows.find((r) => r.portfolioId === p.portfolioId);
	const closed = scene.frames
		.flatMap((f) => f.rows.find((r) => r.portfolioId === p.portfolioId)?.closed ?? [])
		.slice()
		.sort((a, b) => a.tradeDate.localeCompare(b.tradeDate));
	const realizedTotal = closed.reduce((s, c) => s + (c.pnl || 0), 0);
	const invested = row?.positions.reduce((s, pos) => s + (pos.c || 0), 0) ?? 0;
	return { ...p, row, closed, realizedTotal, invested };
});

const sideLabel = (side: string | null) => (side === "short" ? t.short : t.long);
---

<div class="b-det" data-lang={lang}>
	<div class="b-det-tabs" role="tablist" aria-label={t.tabLabel}>
		{agents.map((a, i) => (
			<button
				type="button"
				class="b-det-tab"
				role="tab"
				id={`b-det-tab-${i}`}
				aria-controls={`b-det-panel-${i}`}
				aria-selected={i === 0 ? "true" : "false"}
				tabindex={i === 0 ? 0 : -1}
			>
				<span class="b-det-tav" style={`background:${a.color}`}>
					{a.avatarUrl ? <img src={a.avatarUrl} alt="" loading="lazy" /> : <span>{initialsOf(a.label)}</span>}
				</span>
				<span class="b-det-tname">
					<span class="b-det-tlabel">{a.label}</span>
					<span class="b-det-tsub">{money(a.row?.equity ?? 0, 0)}</span>
				</span>
			</button>
		))}
	</div>

	{agents.map((a, i) => (
		<div
			class="b-det-panel"
			role="tabpanel"
			id={`b-det-panel-${i}`}
			aria-labelledby={`b-det-tab-${i}`}
			hidden={i !== 0}
		>
			<div class="b-det-chips">
				<span class="b-det-chip"><span>{t.equity}</span><b>{money(a.row?.equity ?? 0, 0)}</b></span>
				<span class={`b-det-chip ${(a.row?.profitPct ?? 0) >= 0 ? "b-det-win" : "b-det-loss"}`}>
					<span>P&L</span><b>{capitalPercent(a.row?.profitPct)}</b>
				</span>
				<span class="b-det-chip"><span>{t.invested}</span><b>{money(a.invested, 0)}</b></span>
				<span class="b-det-chip"><span>{t.cash}</span><b>{money(a.row?.liquidity ?? 0, 0)}</b></span>
				<span class="b-det-chip"><span>{t.realized}</span><b>{money(a.row?.realized ?? 0, 0)}</b></span>
				<span class="b-det-chip"><span>{t.unrealized}</span><b>{money(a.row?.unrealized ?? 0, 0)}</b></span>
				<span class="b-det-chip"><span>{t.openChip}</span><b>{a.row?.openCount ?? 0}</b></span>
				<span class="b-det-chip"><span>{t.closedChip}</span><b>{a.closed.length}</b></span>
				<span class="b-det-chip"><span>{t.winloss}</span><b>{a.row?.wins ?? 0} / {a.row?.losses ?? 0}</b></span>
			</div>

			<h4 class="b-det-h4">{t.open} <span class="b-det-count">{a.row?.positions.length ?? 0}</span></h4>
			{a.row && a.row.positions.length > 0 ? (
				<div class="b-det-scroll">
					<table class="b-det-table">
						<thead>
							<tr>
								<th scope="col">{t.asset}</th>
								<th scope="col">{t.side}</th>
								<th scope="col" class="b-det-num">{t.capital}</th>
								<th scope="col" class="b-det-num">{t.pnl}</th>
								<th scope="col" class="b-det-num">{t.pnlPct}</th>
								<th scope="col" class="b-det-num">{t.price}</th>
								<th scope="col">{t.status}</th>
							</tr>
						</thead>
						<tbody>
							{a.row.positions.map((p) => (
								<tr class={p.stale ? "b-det-stale" : ""}>
									<td>
										<span class="b-det-asset">
											{p.avatar ? <img src={p.avatar} alt="" loading="lazy" /> : <span class="b-det-fallback">{p.s.slice(0, 3)}</span>}
											<b>{p.s}</b>
										</span>
									</td>
									<td><span class={`b-det-side b-det-${p.side === "short" ? "short" : "long"}`}>{sideLabel(p.side)}</span></td>
									<td class="b-det-num">{money(p.c, 0)}</td>
									<td class={`b-det-num ${(p.pnl ?? 0) >= 0 ? "b-det-win" : "b-det-loss"}`}>{money(p.pnl, 2)}</td>
									<td class={`b-det-num ${(p.p ?? 0) >= 0 ? "b-det-win" : "b-det-loss"}`}>{capitalPercent(p.p)}</td>
									<td class="b-det-num b-det-sub">{money(p.price, 2)}</td>
									<td>{p.stale ? <span class="b-det-badge">{t.stale}</span> : "—"}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<p class="b-det-empty">{t.noneOpen}</p>
			)}

			<h4 class="b-det-h4">{t.closed} <span class="b-det-count">{a.closed.length}</span></h4>
			{a.closed.length > 0 ? (
				<div class="b-det-scroll">
					<table class="b-det-table">
						<thead>
							<tr>
								<th scope="col">{t.date}</th>
								<th scope="col">{t.asset}</th>
								<th scope="col">{t.side}</th>
								<th scope="col" class="b-det-num">{t.pnl}</th>
								<th scope="col" class="b-det-num">{t.pnlPct}</th>
								<th scope="col">{t.reason}</th>
							</tr>
						</thead>
						<tbody>
							{a.closed.map((c) => (
								<tr>
									<td class="b-det-sub">{formatDay(c.tradeDate)}</td>
									<td>
										<span class="b-det-asset">
											{c.avatar ? <img src={c.avatar} alt="" loading="lazy" /> : <span class="b-det-fallback">{c.s.slice(0, 3)}</span>}
											<b>{c.s}</b>
										</span>
									</td>
									<td><span class={`b-det-side b-det-${c.side === "short" ? "short" : "long"}`}>{sideLabel(c.side)}</span></td>
									<td class={`b-det-num ${(c.pnl ?? 0) >= 0 ? "b-det-win" : "b-det-loss"}`}>{money(c.pnl, 2)}</td>
									<td class={`b-det-num ${(c.p ?? 0) >= 0 ? "b-det-win" : "b-det-loss"}`}>{capitalPercent(c.p)}</td>
									<td>{reasonOf(c.reason)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<p class="b-det-empty">{t.noneClosed}</p>
			)}
		</div>
	))}
</div>

<script>
	const roots = document.querySelectorAll(".b-det");
	roots.forEach((root) => {
		const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
		const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
		const select = (i: number, focus = false) => {
			tabs.forEach((tab, j) => {
				const on = i === j;
				tab.setAttribute("aria-selected", on ? "true" : "false");
				tab.tabIndex = on ? 0 : -1;
				if (on && focus) tab.focus();
			});
			panels.forEach((panel, j) => {
				panel.hidden = j !== i;
			});
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => select(i));
			tab.addEventListener("keydown", (e) => {
				const key = (e as KeyboardEvent).key;
				if (key !== "ArrowRight" && key !== "ArrowLeft" && key !== "Home" && key !== "End") return;
				e.preventDefault();
				const next =
					key === "Home" ? 0 : key === "End" ? tabs.length - 1 : (i + (key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
				select(next, true);
				tabs[next].click();
			});
		});
	});
</script>

<style>
	.b-det { margin-block: 1rem; }
	.b-det-tabs {
		display: flex;
		gap: 0.375rem;
		max-width: 100%;
		overflow-x: auto;
		padding-block-end: 0.25rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.b-det-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
		cursor: pointer;
		padding: 0.4rem 0.7rem;
		border-radius: 0.5rem 0.5rem 0 0;
		border: 1px solid transparent;
		border-bottom: none;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-size: 0.85rem;
		margin-bottom: -1px;
	}
	.b-det-tab:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
	.b-det-tab[aria-selected="true"] {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border-color: var(--sl-color-gray-5);
		border-bottom: 1px solid var(--sl-color-gray-6);
	}
	.b-det-tav {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		border-radius: 50%;
		overflow: hidden;
		font-size: 0.6rem;
		font-weight: 700;
		color: #fff;
	}
	.b-det-tav img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
	.b-det-tname { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
	.b-det-tlabel { font-weight: 600; }
	.b-det-tsub { font-size: 0.68rem; opacity: 0.7; font-variant-numeric: tabular-nums; }

	.b-det-panel { padding-block-start: 0.9rem; }
	.b-det-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-block-end: 1rem; }
	.b-det-chip {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		padding: 0.25rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
	}
	.b-det-chip b { color: var(--sl-color-white); font-variant-numeric: tabular-nums; }

	.b-det-h4 { margin: 0 0 0.5rem; font-size: 0.95rem; }
	.b-det-count {
		display: inline-block;
		margin-inline-start: 0.25rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		font-size: 0.7rem;
		font-weight: 600;
		vertical-align: middle;
	}

	.b-det-scroll { max-width: 100%; overflow-x: auto; margin-block-end: 1rem; }
	.b-det-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
	.b-det-table th {
		text-align: left;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--sl-color-gray-3);
		padding: 0.35rem 0.6rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		white-space: nowrap;
	}
	.b-det-table td { padding: 0.35rem 0.6rem; border-top: 1px solid var(--sl-color-gray-5); vertical-align: middle; white-space: nowrap; }
	.b-det-num { text-align: right; font-variant-numeric: tabular-nums; }
	.b-det-sub { color: var(--sl-color-gray-3); }
	.b-det-win { color: #059669; }
	.b-det-loss { color: #dc2626; }
	:global(:root[data-theme="dark"]) .b-det-win { color: #34d399; }
	:global(:root[data-theme="dark"]) .b-det-loss { color: #f87171; }
	.b-det-stale { opacity: 0.55; }

	.b-det-asset { display: inline-flex; align-items: center; gap: 0.4rem; }
	.b-det-asset img, .b-det-fallback {
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		object-fit: cover;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--sl-color-gray-5);
		font-size: 0.55rem;
		font-weight: 700;
		color: var(--sl-color-gray-2);
	}
	.b-det-side {
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}
	.b-det-long { color: #059669; }
	.b-det-short { color: #d97706; }
	:global(:root[data-theme="dark"]) .b-det-long { color: #34d399; }
	:global(:root[data-theme="dark"]) .b-det-short { color: #fbbf24; }
	.b-det-badge {
		font-size: 0.62rem;
		padding: 0.05rem 0.35rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		color: var(--sl-color-gray-2);
	}
	.b-det-empty { margin: 0 0 1rem; font-size: 0.85rem; color: var(--sl-color-gray-3); }
</style>
