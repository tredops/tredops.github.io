---
// Logo de la cabecera: la marca a tamaño fijo (24 px, como en la landing) más
// el wordmark «TredOps» escrito con dos pesos — «Tred» grueso, «Ops» fino.
//
// El SVG va inline en lugar de como `logo` de Starlight: así hereda
// `currentColor` y sirve para los dos temas con un solo fichero, sin la
// imagen de 27 KB que se colaba escalada a la altura de la barra.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
	<svg class="tredops-mark" viewBox="0 0 24.109268 18.501751" aria-hidden="true" focusable="false">
		<g fill="currentColor" transform="translate(-145.78542,-48.322768)">
			<path d="m 161.76997,58.955343 -2.19408,-0.0097 c -0.53024,4.32953 -3.98515,5.730274 -5.91864,5.666541 -3.58019,-0.110397 -5.56947,-3.1791 -5.58835,-5.123997 l -0.0644,-6.791782 -2.19199,-0.027 -0.0271,6.482576 c 0.211,3.922683 2.87849,7.476178 8.08183,7.672537 2.1488,-0.130086 3.81839,-0.478006 6.19396,-3.077443 1.48214,-1.919335 1.51117,-3.325843 1.70868,-4.791814 z" />
			<path d="m 153.91029,56.191951 2.1941,0.0097 c 0.53025,-4.329529 3.98515,-5.730275 5.91862,-5.66654 3.5802,0.110397 5.5695,3.179099 5.58837,5.123996 l 0.0642,6.629839 h 2.20511 l 0.014,-6.293642 c -0.211,-3.922684 -2.87848,-7.476178 -8.08182,-7.672536 -2.14879,0.130086 -3.81839,0.478006 -6.19398,3.077442 -1.48212,1.919337 -1.51114,3.325844 -1.70865,4.791815 z" />
			<path d="m 148.58458,52.688848 h 2.19848 v 6.313928 c 0.28873,2.146401 1.76046,2.719016 3.06684,2.775138 1.76358,-0.07171 2.65571,-1.403642 2.88645,-2.775138 l 0.04,-3.466347 c 0.10808,-1.947315 2.10572,-4.460502 5.30184,-4.497993 2.96977,0.190902 4.65692,2.25449 5.03121,4.694006 v 6.581932 h -2.17484 l -0.05,-6.509718 c -0.42611,-1.585195 -1.38793,-2.421018 -2.85637,-2.548175 -1.64102,0.05511 -2.66167,0.82209 -3.0468,2.445012 l -0.0523,3.660536 c -0.69055,3.374848 -2.75676,4.305779 -4.99517,4.560482 -3.066,-0.150414 -4.85515,-1.578413 -5.35572,-4.507076 z" />
		</g>
	</svg>
	<span class="tredops-wordmark"><b>Tred</b><i>Ops</i></span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.5rem;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.tredops-mark {
		/* Tamaño fijo: la marca no crece con la altura de la barra. */
		width: 1.5rem;
		height: 1.5rem;
		flex-shrink: 0;
		overflow: visible;
		color: var(--sl-color-white);
	}
	.tredops-wordmark {
		display: inline-flex;
		align-items: baseline;
		overflow: hidden;
		font-family: 'Space Grotesk', var(--sl-font);
		font-size: 1.125rem;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.tredops-wordmark b {
		font-weight: 700;
	}
	.tredops-wordmark i {
		font-style: normal;
		font-weight: 300;
	}
	@media (max-width: 30rem) {
		.tredops-wordmark {
			font-size: 1rem;
		}
	}
</style>
